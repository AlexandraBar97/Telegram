    print(f"\nБазовая статистика:"
          f"\nКоличество постов: {stats['Количество постов']}"
          f"\nОбщее число просмотров: {stats['Общее число просмотров']}"
          f"\nСреднее число просмотров: {stats['Среднее число просмотров']:.2f}"
          f"\nМедиана просмотров: {stats['Медиана просмотров']}"
          f"\nМаксимальное число просмотров: {stats['Максимальное число просмотров']}"
          f"\nМинимальное число просмотров: {stats['Минимальное число просмотров']}")
    
    print("\nПосты по дням недели:")
    for day, count in posts.items():
        print(f"{day}: {count}")
    
    print("\nСредние просмотры по дням недели:")
    for day, avg_views in views.items():
        print(f"{day}: {avg_views:.2f}")
    
    views = views_by_day(df)
    short_names = {
    'Понедельник': 'Пн',
    'Вторник': 'Вт',
    'Среда': 'Ср',
    'Четверг': 'Чт',
    'Пятница': 'Пт',
    'Суббота': 'Сб',
    'Воскресенье': 'Вс'
    } # заменяем длинные названия на короткие
    cmap = get_cmap('tab20b') # tab20b — это одна из встроенных цветовых схем
    colors = [cmap(i) for i in range(len(views))] # список с цветами по количеству дней недели
    plt.figure()
    ax_views = views.plot(kind="bar", color=colors, legend=False)
    plt.title("Средние просмотры по дням недели")
    ax_views.set_xticklabels([short_names.get(day, day) for day in views.index]) # метод ax.set_xticklabels() заменяет метки на оси X, ax.set_yticklabels() - по оси Y
    # .get(key, default) - возьми значение по ключу day из словаря short_name, если такого ключа нет — возвращай сам day без изменений»
    plt.show()

    cmap = get_cmap('tab20b') # tab20b — это одна из встроенных цветовых схем
    colors_posts = [cmap(i) for i in range(len(posts))]
    plt.figure()
    ax_posts = posts.plot(kind="bar", color=colors, legend=False)
    plt.title("Количество постов по дням недели")
